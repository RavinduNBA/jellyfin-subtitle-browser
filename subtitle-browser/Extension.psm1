$ErrorActionPreference = 'Stop'
$script:FeatureMarker = '/* Jellyfin Media Player in-client Subtitle Browser. No additional login or IPC. */'

function Get-SubtitleBrowserBundle {
    $source = Join-Path $PSScriptRoot 'src'
    $css = [IO.File]::ReadAllText((Join-Path $source 'subtitle-browser.css'))
    $styleJson = ConvertTo-Json -InputObject $css -Compress
    $pieces = @(
        $script:FeatureMarker
        '/* Generated by Build-Extension.ps1. Edit src/ instead. */'
        [IO.File]::ReadAllText((Join-Path $source 'core.js'))
        [IO.File]::ReadAllText((Join-Path $source 'theme.js'))
        ('window.JellyfinSubtitleStyles = ' + $styleJson + ';')
        [IO.File]::ReadAllText((Join-Path $source 'browser.js'))
    )
    return ($pieces -join "`n") + "`n"
}

function Set-SubtitleBrowserExtension {
    param([Parameter(Mandatory)][string]$BridgeFile, [string]$OriginalScript)
    if (-not $PSBoundParameters.ContainsKey('OriginalScript')) { $OriginalScript = [IO.File]::ReadAllText($BridgeFile) }
    $index = $OriginalScript.IndexOf($script:FeatureMarker)
    if ($index -ge 0) { $OriginalScript = $OriginalScript.Substring(0, $index) }
    if ($OriginalScript -notmatch 'window\._mpvVideoPlayer\s*=' -or $OriginalScript -notmatch 'setCurrentSrc\(') {
        throw 'Unrecognized Jellyfin video bridge. The installed file was left unchanged.'
    }
    $temporary = $BridgeFile + '.subtitle-browser-tmp'
    [IO.File]::WriteAllText($temporary, $OriginalScript.TrimEnd() + "`n`n" + (Get-SubtitleBrowserBundle), [Text.UTF8Encoding]::new($false))
    Move-Item -LiteralPath $temporary -Destination $BridgeFile -Force
}

Export-ModuleMember -Function Get-SubtitleBrowserBundle, Set-SubtitleBrowserExtension
